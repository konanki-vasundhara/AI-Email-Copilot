# ==========================================
# AI Email Copilot - Environment Configuration
# ==========================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="AI Email Copilot"
API_V1_PREFIX="/api/v1"

# Database Configuration
# PostgreSQL default local credentials (update if your postgres user/password differs)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_email_copilot
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/ai_email_copilot

# Token Encryption Secret Key (Fernet key: generate with `cryptography.fernet.Fernet.generate_key().decode()`)
# MUST be 32 url-safe base64-encoded bytes
TOKEN_ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3Qta2V5LTMyLWJ5dGVzLWxvbmctISE=

# Google OAuth Credentials (configured in Milestone 2)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Redis / Background Worker
REDIS_URL=redis://localhost:6379/0

# Hugging Face Configuration (Milestone 4)
HF_API_TOKEN=
HF_MODEL_CLASSIFIER=facebook/bart-large-mnli
HF_MODEL_SUMMARIZER=facebook/bart-large-cnn

